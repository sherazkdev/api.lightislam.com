# Local dev: 3000 | VPS (behind nginx): 3022
PORT=3000
HOST=0.0.0.0
MONGODB_URI=mongodb://127.0.0.1:27017/light-islam

# Production required — mobile app header: x-api-key
APP_API_KEY=change-me-long-random-string

# Firebase Admin (service account JSON file ki zaroorat nahi — Firebase Console se values copy karein)
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project-id.iam.gserviceaccount.com
# Private key ek line mein; newlines ke liye \n use karein (quotes optional)
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n"
