# Copy to repo root on VPS: cp deploy/env.production.example .env
# Worker does NOT use a TCP port — only API listens (3022 behind nginx).

NODE_ENV=production
HOST=0.0.0.0
# MUST match nginx upstream (deploy/nginx) and PM2 ecosystem — not 3000
PORT=3022

MONGODB_URI=mongodb://127.0.0.1:27017/light-islam

FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project-id.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n"
