{
  "name": "light-islam-api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "start:worker": "node dist/worker.js",
    "worker": "tsx src/worker.ts",
    "pm2:start": "pm2 start deploy/ecosystem.config.cjs",
    "pm2:reload": "npm run build && pm2 reload deploy/ecosystem.config.cjs"
  },
  "dependencies": {
    "@fastify/sensible": "^6.0.3",
    "@fastify/swagger": "^9.9.0",
    "@fastify/swagger-ui": "^6.1.1",
    "dotenv": "^17.2.2",
    "fastify": "^5.12.5",
    "firebase-admin": "^13.5.0",
    "luxon": "^3.7.2",
    "mongoose": "^8.18.1",
    "node-cron": "^4.2.1",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@types/luxon": "^3.7.1",
    "@types/node": "^24.3.1",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  }
}
