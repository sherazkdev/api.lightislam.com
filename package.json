{
  "name": "light-islam-api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "dev:worker": "tsx src/worker.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "start:worker": "node dist/worker.js",
    "worker": "tsx src/worker.ts",
    "prod:install": "npm ci",
    "prod:build": "npm run build",
    "prod:prune": "npm prune --omit=dev",
    "prod:pm2": "pm2 start deploy/ecosystem.config.cjs",
    "prod:reload": "pm2 reload deploy/ecosystem.config.cjs --update-env",
    "prod:setup": "npm run prod:install && npm run prod:build && npm run prod:prune && npm run prod:pm2",
    "prod:deploy": "npm run prod:install && npm run prod:build && npm run prod:prune && npm run prod:reload",
    "prod:stop": "pm2 stop light-islam-reminder-api light-islam-reminder-worker",
    "prod:logs": "pm2 logs light-islam-reminder-api light-islam-reminder-worker",
    "prod:status": "pm2 status",
    "pm2:start": "npm run prod:pm2",
    "pm2:reload": "npm run prod:build && npm run prod:reload"
  },
  "dependencies": {
    "@fastify/rate-limit": "^11.2.0",
    "@fastify/sensible": "^6.0.3",
    "@fastify/swagger": "^9.9.0",
    "@fastify/swagger-ui": "^6.1.1",
    "dotenv": "^17.2.2",
    "fastify": "^5.12.5",
    "firebase-admin": "^13.5.0",
    "luxon": "^3.7.2",
    "mongoose": "^8.18.1",
    "node-cron": "^4.2.1",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@types/luxon": "^3.7.1",
    "@types/node": "^24.3.1",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  }
}
